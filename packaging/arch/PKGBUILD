# Maintainer: 74mdi <7amdi@tuta.io>
pkgname=koko-widget
pkgver=0.1.0
pkgrel=1
pkgdesc="Native Liquid Glass floating widget overlay: MPRIS music, clock, date and text as movable glass pills"
arch=('x86_64' 'aarch64')
url="https://github.com/74mdi/koko-widget"
license=('MIT')
depends=('gtk4' 'pango' 'cairo' 'glib2')
optdepends=('gtk4-layer-shell: Wayland layer surfaces on wlroots and niri')
makedepends=('cargo' 'rust' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    # Build against the system GTK; the vendored lockfile is used as-is so a
    # package build does not silently pull newer crates.
    cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
    cd "$pkgname-$pkgver"
    export CARGO_BUILD_JOBS=1
    cargo build --frozen --release --all-features
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/koko-widget "$pkgdir/usr/bin/koko-widget"
    install -Dm644 "data/io.github.kokowidget.KokoWidget.desktop" \
        "$pkgdir/usr/share/applications/io.github.kokowidget.KokoWidget.desktop"
    for size in 16 24 32 48 64 128 256 512; do
        install -Dm644 "assets/icons/hicolor/${size}x${size}/apps/io.github.kokowidget.KokoWidget.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/io.github.kokowidget.KokoWidget.png"
    done
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
